rules_version = '2';

// Reglas de seguridad de Firestore para Vortex Shop.
// Copiar en: Consola de Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // true si el usuario logueado tiene rol "admin" en su documento usuarios/{uid}
    function esAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    // Cada usuario solo puede leer y escribir SU propio documento (usuarios/{uid}).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Al registrarse, el rol solo puede ser "cliente"
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == "cliente";

      // Puede editar sus datos, pero nunca cambiarse el rol a sí mismo
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol;

      allow delete: if false;
    }

    // Catálogo: cualquier visitante puede ver los productos (aunque no haya iniciado sesión).
    // Solo un administrador puede crearlos, modificarlos o eliminarlos.
    match /productos/{idProducto} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}